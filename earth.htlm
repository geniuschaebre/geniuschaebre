<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<title>Earth Map</title>

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<link rel="stylesheet" 
href="https://unpkg.com/leaflet/dist/leaflet.css"/>

<style>

html,body{
    margin:0;
    width:100%;
    height:100%;
}

#map{
    width:100%;
    height:100%;
}

.title{
    position:absolute;
    top:10px;
    left:50%;
    transform:translateX(-50%);
    z-index:999;
    background:black;
    color:white;
    padding:10px 25px;
    border-radius:20px;
    font-size:25px;
}

</style>

</head>


<body>


<div class="title">
🌍 EARTH EARTHQUAKE MAP
</div>


<div id="map"></div>



<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>


<script>


// 지도 생성

const map=L.map("map").setView(
[20,0],
2
);


// 세계지도

L.tileLayer(
"https://tile.openstreetmap.org/{z}/{x}/{y}.png",
{
maxZoom:18
}
).addTo(map);




// 지진 데이터

const earthquakes=[

{
name:"대한민국 서울",
lat:37.5665,
lng:126.978,
power:3.5
},

{
name:"일본 도쿄",
lat:35.6762,
lng:139.6503,
power:5.2
},

{
name:"미국 캘리포니아",
lat:36.7783,
lng:-119.4179,
power:4.8
},

{
name:"인도네시아",
lat:-6.2,
lng:106.8,
power:6.0
},

{
name:"칠레",
lat:-33.4,
lng:-70.6,
power:5.5
},

{
name:"터키",
lat:39.9,
lng:32.8,
power:4.2
}

];




// 지진 표시

earthquakes.forEach(eq=>{


let color;


if(eq.power>=5){
    color="red";
}
else{
    color="orange";
}



let marker=L.circleMarker(
[eq.lat,eq.lng],
{

radius:eq.power*3,

color:color,

fillColor:color,

fillOpacity:0.7

}

)
.addTo(map);



marker.bindPopup(

`
<h3>🌋 지진 발생</h3>

지역 : ${eq.name}<br>

규모 : ${eq.power}

`

);


});




// 현재 위치 표시

navigator.geolocation?.getCurrentPosition(
pos=>{


L.marker([

pos.coords.latitude,

pos.coords.longitude

])
.addTo(map)
.bindPopup("📍 현재 위치")
.openPopup();


}

);



</script>


</body>
</html>
