<!DOCTYPE html>
<html lang="ko">

<head>

<meta charset="UTF-8">

<title>천재채호 - 실시간 지진 지도</title>


<style>

*{

margin:0;
padding:0;
box-sizing:border-box;

}


body{

overflow:hidden;

font-family:"Malgun Gothic";

}


#map{

width:100vw;

height:100vh;

position:relative;


background-image:

url("https://upload.wikimedia.org/wikipedia/commons/8/83/Earthmap1000x500.jpg");

background-size:cover;

}



#title{

position:absolute;

top:20px;

left:20px;

z-index:10;

background:black;

color:white;

padding:15px;

font-size:28px;

border-radius:10px;

}



#back{

position:absolute;

top:20px;

right:20px;

z-index:10;

background:blue;

color:white;

border:none;

padding:15px 25px;

font-size:20px;

border-radius:10px;

cursor:pointer;

}



.quake{

position:absolute;

background:red;

border-radius:50%;

box-shadow:

0 0 10px red,

0 0 25px red;


animation:pulse 1s infinite;

}



@keyframes pulse{

50%{

transform:scale(1.8);

}

}



#info{

position:absolute;

bottom:20px;

left:20px;

background:rgba(0,0,0,.7);

color:white;

padding:15px;

border-radius:10px;

}



</style>


</head>


<body>


<div id="map">


<div id="title">
🌎 천재채호 실시간 지진 지도
</div>


<button id="back" onclick="location.href='index.html'">
⬅ 돌아가기
</button>


<div id="info">
지진 데이터 불러오는 중...
</div>


</div>




<script>


const map=document.getElementById("map");

const info=document.getElementById("info");



function position(lat,lon){

return{

x:(lon+180)/360*100,

y:(90-lat)/180*100

};

}



async function earthquake(){


try{


let data=

await fetch(
"https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson"
)
.then(r=>r.json());



document.querySelectorAll(".quake")
.forEach(e=>e.remove());



info.innerHTML=
"최근 24시간 지진 : "
+data.features.length+"개";



data.features.forEach(e=>{


let lon=e.geometry.coordinates[0];

let lat=e.geometry.coordinates[1];

let mag=e.properties.mag;


let p=position(lat,lon);



let dot=document.createElement("div");

dot.className="quake";


dot.style.left=p.x+"%";

dot.style.top=p.y+"%";


let size=8+mag*5;


dot.style.width=size+"px";

dot.style.height=size+"px";



dot.onclick=()=>{

alert(
"규모 : "+mag+
"\n위치 : "+e.properties.place
);

};



map.appendChild(dot);


});


}

catch{

info.innerHTML=
"지진 데이터를 가져올 수 없습니다.";

}


}



earthquake();

setInterval(earthquake,60000);


</script>


</body>

</html>
